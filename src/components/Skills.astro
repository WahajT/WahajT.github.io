---
import { Image } from 'astro:assets';
import { skillGroups } from '@/data/skills';
import SectionHeader from './SectionHeader.astro';
---

<section id="skills" class="section">
  <div class="container">
    <SectionHeader
      index="04"
      eyebrow="Skills"
      title="The tools I reach for."
      intro="Grouped by what they're for. Primary means daily use and interview-ready; working means productive when a project calls for it."
    />

    <div class="skills__grid">
      {
        skillGroups.map((group, i) => (
          <article class="skills__group card card--hover" data-reveal style={`--reveal-delay:${i * 55}ms`}>
            <h3 class="skills__group-title">{group.title}</h3>
            <p class="skills__group-blurb">{group.blurb}</p>
            <ul class="skills__list" role="list">
              {group.skills.map((s) => (
                <li class="skills__item" data-level={s.level}>
                  {s.icon && (
                    <Image src={s.icon} alt="" width={22} height={22} densities={[1, 2]} loading="lazy" />
                  )}
                  <span>{s.name}</span>
                  {s.level === 'primary' && <span class="skills__badge" title="Primary — daily use" />}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .skills__group {
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }
  .skills__group-title {
    font-size: var(--step-1);
  }
  .skills__group-blurb {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--text-faint);
  }
  .skills__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-md);
  }
  .skills__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
    background: var(--surface-2);
  }
  .skills__item[data-level='primary'] {
    color: var(--text);
    border-color: var(--accent-border);
    background: var(--accent-surface);
  }
  .skills__item :global(img) {
    width: 1.1rem;
    height: 1.1rem;
    object-fit: contain;
  }
  .skills__badge {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--brand);
  }
</style>
