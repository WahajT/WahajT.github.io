---
import { site } from '@/data/site';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';

/* TODO(wahaj): rewrite these three points in your own voice. Keep them short
   and concrete — what you do, the domain, and one thing you're known for. */
const points = [
  'I work at the seam between QA and infrastructure: designing test-automation frameworks and the CI/CD that runs them, so teams get fast, trustworthy signal on every change.',
  'Most of my work has been in mobile device diagnostics (PhoneCheck, Mobocheck) — driving real Android and iOS hardware from automated suites and keeping the pipelines that ship them healthy.',
  'I care about flaky-test triage, reproducible environments, and reports a developer can actually act on. Comfortable owning a suite end-to-end, from device grid to merge-request gate.',
];

const facts = [
  { label: 'Focus', value: 'Test automation · CI/CD' },
  { label: 'Domain', value: 'Mobile device diagnostics' },
  { label: 'Based in', value: site.location },
  { label: 'Working in', value: site.timezone },
];

const media = site.aboutMedia;
const hasMedia = media.type === 'video' || media.type === 'image';
---

<section id="about" class="section">
  <div class="container">
    <SectionHeader
      index="01"
      eyebrow="About"
      title="SDET who treats the pipeline as part of the product."
    />

    <div class="about__grid">
      <div class="about__col">
        {/* --- Media panel: short intro clip or photo --- */}
        <figure class="about__media" data-reveal data-state={media.type}>
          {
            media.type === 'video' && (
              <video
                class="about__media-el"
                src={media.src}
                poster={media.poster || undefined}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={media.alt}
              />
            )
          }
          {
            media.type === 'image' && (
              <img class="about__media-el" src={media.src} alt={media.alt} loading="lazy" decoding="async" />
            )
          }
          {
            !hasMedia && (
              <div class="about__media-placeholder">
                <Icon name="arrowUpRight" />
                <p>
                  <strong>Intro video goes here.</strong>
                  <br />
                  Add an <code>mp4</code> to <code>/public</code> and set{' '}
                  <code>aboutMedia</code> in <code>src/data/site.ts</code>.
                </p>
              </div>
            )
          }
          {media.caption && <figcaption class="about__media-cap">{media.caption}</figcaption>}
        </figure>

        <div class="about__points">
          {points.map((p, i) => <p style={`--reveal-delay:${i * 60}ms`} data-reveal>{p}</p>)}
        </div>
      </div>

      <dl class="about__facts card" data-reveal>
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: start;
    }
  }

  .about__col {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
  }

  /* ---- media panel ---- */
  .about__media {
    position: relative;
    margin: 0;
  }
  .about__media::before {
    content: '';
    position: absolute;
    inset: 0;
    translate: 14px 14px;
    border: 1px solid var(--brand);
    border-radius: var(--radius-lg);
    opacity: 0.5;
    z-index: -1;
  }
  .about__media-el,
  .about__media-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-2);
    box-shadow: var(--shadow-md);
  }
  .about__media-el {
    object-fit: cover;
  }
  .about__media-placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: var(--space-lg);
    text-align: center;
    color: var(--text-faint);
    background:
      radial-gradient(circle at 30% 25%, var(--accent-surface), transparent 60%),
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 10px,
        color-mix(in srgb, var(--border) 55%, transparent) 10px,
        color-mix(in srgb, var(--border) 55%, transparent) 11px
      ),
      var(--surface-2);
  }
  .about__media-placeholder :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--accent-text);
  }
  .about__media-placeholder p {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    max-width: 34ch;
  }
  .about__media-placeholder code {
    color: var(--text-muted);
  }
  .about__media-cap {
    margin-top: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .about__points {
    display: grid;
    gap: var(--space-md);
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .about__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
  }
  .about__facts > div {
    padding: var(--space-md) var(--space-lg);
  }
  .about__facts > div:nth-child(-n + 2) {
    border-bottom: 1px solid var(--border);
  }
  .about__facts > div:nth-child(odd) {
    border-right: 1px solid var(--border);
  }
  .about__facts dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }
  .about__facts dd {
    margin-top: 0.3rem;
    font-weight: 600;
    color: var(--text);
  }
</style>
