---
import { Image } from 'astro:assets';
import { site } from '@/data/site';
import Icon from './Icon.astro';
import logoMark from '@/assets/logo-mark.png';

const year = new Date().getFullYear();
const iconFor: Record<string, 'github' | 'linkedin' | 'mail'> = {
  github: 'github',
  linkedin: 'linkedin',
  mail: 'mail',
};
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__id">
        <Image
          src={logoMark}
          alt={site.brand.name}
          width={88}
          height={51}
          densities={[1, 2]}
          loading="lazy"
          class="site-footer__mark"
        />
        <div>
          <p class="site-footer__name">{site.name}</p>
          <p class="site-footer__role">{site.role} · {site.location}</p>
        </div>
      </div>

      <nav class="site-footer__links" aria-label="Social">
        {
          site.socials.map((s) => (
            <a
              href={s.url}
              target={s.url.startsWith('http') ? '_blank' : undefined}
              rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={s.name}
            >
              <Icon name={iconFor[s.icon] ?? 'external'} />
            </a>
          ))
        }
      </nav>
    </div>

    <p class="site-footer__copy">© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    padding-block: var(--space-xl) var(--space-lg);
  }
  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: center;
    justify-content: space-between;
  }
  .site-footer__id {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .site-footer__mark {
    height: 2.4rem;
    width: auto;
  }
  @media (prefers-color-scheme: dark) {
    .site-footer__mark {
      filter: brightness(1.18) saturate(1.05);
    }
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-weight: 550;
    color: var(--text);
  }
  .site-footer__role {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .site-footer__links {
    display: flex;
    gap: var(--space-xs);
  }
  .site-footer__links a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    background: var(--surface);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .site-footer__links a:hover {
    color: var(--text);
    border-color: var(--accent-border);
    transform: translateY(-2px);
  }
  .site-footer__links :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .site-footer__copy {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
