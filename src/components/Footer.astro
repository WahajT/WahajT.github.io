---
import { site } from '@/data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const iconFor: Record<string, 'github' | 'linkedin' | 'mail'> = {
  github: 'github',
  linkedin: 'linkedin',
  mail: 'mail',
};
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div>
        <p class="site-footer__name">{site.name}</p>
        <p class="site-footer__role">{site.role} · {site.location}</p>
      </div>

      <nav class="site-footer__links" aria-label="Social">
        {
          site.socials.map((s) => (
            <a
              href={s.url}
              target={s.url.startsWith('http') ? '_blank' : undefined}
              rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={s.name}
            >
              <Icon name={iconFor[s.icon] ?? 'external'} />
            </a>
          ))
        }
      </nav>
    </div>

    <p class="site-footer__wordmark" aria-hidden="true">{site.name}</p>

    <div class="site-footer__meta">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Built with Astro · hosted on GitHub Pages · <a href="#main" class="link-underline">Back to top ↑</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    padding-block: var(--space-2xl) var(--space-lg);
    overflow: hidden;
  }
  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: center;
    justify-content: space-between;
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-weight: 550;
    color: var(--text);
  }
  .site-footer__role {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .site-footer__links {
    display: flex;
    gap: var(--space-xs);
  }
  .site-footer__links a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    background: var(--surface);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .site-footer__links a:hover {
    color: var(--text);
    border-color: var(--accent-border);
    transform: translateY(-2px);
  }
  .site-footer__links :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .site-footer__wordmark {
    margin-block: clamp(1.5rem, 5vw, 3rem) 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3rem, 15vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--border-strong);
    opacity: 0.5;
    user-select: none;
    white-space: nowrap;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    justify-content: space-between;
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .site-footer__meta a {
    color: var(--text-muted);
  }
</style>
