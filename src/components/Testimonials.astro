---
import { Image } from 'astro:assets';
import { testimonials } from '@/data/testimonials';
import Icon from './Icon.astro';
---

<section class="section" aria-labelledby="testimonials-title">
  <div class="container">
    <div class="tm__head" data-reveal>
      <p class="eyebrow">References</p>
      <h2 id="testimonials-title" class="section-title">People I've worked with.</h2>
    </div>

    <div class="tm__grid">
      {
        testimonials.map((t, i) => (
          <figure class="tm__card" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <blockquote class="tm__quote">"{t.quote}"</blockquote>
            <figcaption class="tm__person">
              <Image
                src={t.photo}
                alt={`${t.name}`}
                width={44}
                height={44}
                densities={[1, 2]}
                loading="lazy"
              />
              <span>
                <span class="tm__name">
                  {t.url ? (
                    <a href={t.url} target="_blank" rel="noopener noreferrer">
                      {t.name}
                      <Icon name="external" />
                    </a>
                  ) : (
                    t.name
                  )}
                </span>
                <span class="tm__title">{t.title}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tm__head {
    margin-bottom: var(--space-xl);
  }
  .tm__grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .tm__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .tm__quote {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  .tm__person {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
  }
  .tm__person :global(img) {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .tm__name {
    display: block;
    font-weight: 600;
    color: var(--text);
  }
  .tm__name a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: inherit;
    text-decoration: none;
  }
  .tm__name :global(svg) {
    width: 0.85rem;
    color: var(--text-faint);
  }
  .tm__title {
    font-size: var(--step--1);
    color: var(--text-faint);
  }
</style>
