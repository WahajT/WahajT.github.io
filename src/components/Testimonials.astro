---
import { Image } from 'astro:assets';
import { testimonials } from '@/data/testimonials';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
---

<section class="section">
  <div class="container">
    <SectionHeader index="05" eyebrow="References" title="People I've worked with." />

    <div class="tm__grid">
      {
        testimonials.map((t, i) => (
          <figure class="tm__card card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="tm__quote-mark" aria-hidden="true">
              “
            </span>
            <blockquote class="tm__quote">{t.quote}</blockquote>
            <figcaption class="tm__person">
              <Image src={t.photo} alt={t.name} width={44} height={44} densities={[1, 2]} loading="lazy" />
              <span>
                <span class="tm__name">
                  {t.url ? (
                    <a class="link-underline" href={t.url} target="_blank" rel="noopener noreferrer">
                      {t.name}
                      <Icon name="external" />
                    </a>
                  ) : (
                    t.name
                  )}
                </span>
                <span class="tm__title">{t.title}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tm__grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .tm__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: clamp(1.5rem, 4vw, 2rem);
  }
  .tm__quote-mark {
    font-family: var(--font-display);
    font-size: 3.5rem;
    line-height: 0.6;
    color: var(--accent-border);
    height: 1.2rem;
  }
  .tm__quote {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  .tm__person {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
  }
  .tm__person :global(img) {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .tm__name {
    display: block;
    font-weight: 600;
    color: var(--text);
  }
  .tm__name a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: inherit;
  }
  .tm__name :global(svg) {
    width: 0.85rem;
    color: var(--text-faint);
  }
  .tm__title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }
</style>
