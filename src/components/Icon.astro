---
/**
 * Inline SVG icons. Only the handful the site actually uses — no icon font.
 * All paths use `currentColor` so they inherit text colour.
 */
interface Props {
  name: keyof typeof paths;
  size?: number | string;
  class?: string;
  title?: string;
}

const { name, size = '1em', class: className, title } = Astro.props;

