---
import { Image } from 'astro:assets';
import { site } from '@/data/site';
import Icon from './Icon.astro';
import CopyEmail from './CopyEmail.astro';
import profile from '@/assets/profile.webp';

const iconFor: Record<string, 'github' | 'linkedin' | 'mail'> = {
  github: 'github',
  linkedin: 'linkedin',
  mail: 'mail',
};
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__glow"></span>
    <span class="hero__grid"></span>
  </div>

  <div class="container hero__grid-wrap">
    <div class="hero__body">
      {
        site.availability.open && (
          <p class="hero__status">
            <span class="hero__status-dot" aria-hidden="true" />
            {site.availability.label}
          </p>
        )
      }

      <h1 id="hero-title" class="hero__title">{site.name}</h1>
      <p class="hero__role">{site.role}</p>
      <p class="hero__headline">{site.headline}</p>

      <div class="hero__cta">
        <a class="btn" href="#projects">
          View projects
          <Icon name="arrowDown" />
        </a>
        <a class="btn btn--ghost" href={site.resume} download>
          <Icon name="download" />
          Download résumé
        </a>
        <CopyEmail label="Copy email" />
      </div>

      <ul class="hero__socials" role="list">
        {
          site.socials.map((s) => (
            <li>
              <a
                class="link-underline"
                href={s.url}
                target={s.url.startsWith('http') ? '_blank' : undefined}
                rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <Icon name={iconFor[s.icon] ?? 'external'} />
                <span>{s.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="hero__portrait">
      <Image
        src={profile}
        alt={`Portrait of ${site.name}`}
        width={440}
        height={548}
        widths={[280, 440, 640, 880]}
        sizes="(max-width: 900px) 55vw, 380px"
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="hero__portrait-tag">
        <Icon name="pin" />
        {site.location} · {site.timezone}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 9vw, 7rem) clamp(3rem, 8vw, 5.5rem);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__glow {
    position: absolute;
    top: -20%;
    left: -10%;
    width: min(60rem, 90vw);
    height: min(60rem, 90vw);
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--brand) 32%, transparent),
      transparent 62%
    );
    filter: blur(20px);
    opacity: 0.55;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 1px 1px, var(--border-strong) 1px, transparent 0);
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 25%, transparent 75%);
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 25%, transparent 75%);
    opacity: 0.5;
  }

  .hero__grid-wrap {
    position: relative;
    display: grid;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__grid-wrap {
      grid-template-columns: 1.5fr 0.85fr;
    }
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--accent-border);
    background: var(--accent-surface);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: var(--space-lg);
  }
  .hero__status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1f9d55;
    box-shadow: 0 0 0 3px color-mix(in srgb, #1f9d55 25%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__status-dot {
      animation: pulse 2.6s var(--ease-out) infinite;
    }
    @keyframes pulse {
      0%,
      100% {
        box-shadow: 0 0 0 3px color-mix(in srgb, #1f9d55 25%, transparent);
      }
      50% {
        box-shadow: 0 0 0 7px color-mix(in srgb, #1f9d55 0%, transparent);
      }
    }
  }

  .hero__title {
    font-size: var(--step-5);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .hero__role {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--accent-text);
    letter-spacing: var(--tracking-tight);
  }
  .hero__headline {
    margin-top: var(--space-lg);
    max-width: 42ch;
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xl);
  }

  .hero__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-lg);
  }
  .hero__socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: var(--step--1);
    font-family: var(--font-mono);
  }
  .hero__socials a:hover {
    color: var(--text);
  }
  .hero__socials :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .hero__portrait {
    position: relative;
    justify-self: center;
    width: min(380px, 72vw);
  }
  .hero__portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    translate: 14px 14px;
    border: 1px solid var(--brand);
    border-radius: var(--radius-lg);
    opacity: 0.55;
    z-index: -1;
  }
  .hero__portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 44 / 52;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }
  .hero__portrait-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-sm);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .hero__portrait-tag :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 899px) {
    .hero__portrait {
      justify-self: start;
      width: min(240px, 52vw);
    }
  }
</style>
