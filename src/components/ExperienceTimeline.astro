---
import { Image } from 'astro:assets';
import { experience } from '@/data/experience';
import SectionHeader from './SectionHeader.astro';
---

<section id="experience" class="section section--tint">
  <div class="container">
    <SectionHeader
      index="02"
      eyebrow="Experience"
      title="Where I've done the work."
      intro="Across QA and platform teams — from manual testing into owning automation frameworks and the CI/CD that runs them."
    />

    <ol class="xp" role="list">
      {
        experience.map((job, i) => (
          <li class="xp__item" data-reveal style={`--reveal-delay:${Math.min(i, 4) * 55}ms`}>
            <div class="xp__marker" aria-hidden="true">
              {job.logo ? (
                <Image src={job.logo} alt="" width={44} height={44} densities={[1, 2]} loading="lazy" />
              ) : (
                <span class="xp__marker-initials">
                  {job.company
                    .split(' ')
                    .slice(0, 2)
                    .map((w) => w[0])
                    .join('')}
                </span>
              )}
            </div>

            <div class="xp__content card">
              <div class="xp__meta">
                <h3 class="xp__role">{job.title}</h3>
                <p class="xp__company">
                  {job.url ? (
                    <a class="link-underline" href={job.url} target="_blank" rel="noopener noreferrer">
                      {job.company}
                    </a>
                  ) : (
                    job.company
                  )}
                  {job.location && <span class="xp__loc"> · {job.location}</span>}
                </p>
                <p class="xp__dates">
                  {job.start} — {job.end}
                </p>
              </div>

              <p class="xp__summary">{job.summary}</p>

              {job.highlights.length > 0 && (
                <ul class="xp__highlights" role="list">
                  {job.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}

              {job.stack.length > 0 && (
                <ul class="xp__stack" role="list">
                  {job.stack.map((s) => (
                    <li class="chip">{s}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .xp {
    display: grid;
    gap: var(--space-lg);
  }
  .xp__item {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-lg);
    position: relative;
  }
  .xp__item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.6rem;
    top: 3.6rem;
    bottom: calc(-1 * var(--space-lg));
    width: 1px;
    background: var(--border-strong);
  }

  .xp__marker {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    box-shadow: inset 0 1px 0 var(--hairline);
    overflow: hidden;
  }
  .xp__marker :global(img) {
    width: 1.9rem;
    height: 1.9rem;
    object-fit: contain;
  }
  .xp__marker-initials {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--accent-text);
    letter-spacing: 0.02em;
  }

  .xp__content {
    padding: clamp(1.1rem, 3vw, 1.6rem);
  }
  .xp__role {
    font-size: var(--step-1);
  }
  .xp__company {
    margin-top: 0.15rem;
    font-weight: 600;
    color: var(--text);
  }
  .xp__company a {
    color: inherit;
  }
  .xp__loc {
    font-weight: 400;
    color: var(--text-faint);
  }
  .xp__dates {
    margin-top: 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .xp__summary {
    margin-top: var(--space-sm);
    color: var(--text-muted);
    max-width: var(--measure);
  }
  .xp__highlights {
    margin-top: var(--space-sm);
    display: grid;
    gap: 0.45rem;
    max-width: var(--measure);
  }
  .xp__highlights li {
    position: relative;
    padding-left: 1.3rem;
    color: var(--text-muted);
  }
  .xp__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
  }
  .xp__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-md);
  }

  @media (max-width: 560px) {
    .xp__item {
      grid-template-columns: 1fr;
    }
    .xp__item::before {
      display: none;
    }
  }
</style>
